# Observatório do Diagnóstico Educacional de Angola & Luanda
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
#
# Em produção (Hostinger hPanel ou Servidor VPS):
# Copie este arquivo para .env ou configure as variáveis diretamente no painel de controle.

# Chave secreta de autenticação para disparos do extrator via requisição HTTP/Web (?token=...)
# Em tarefas Cron CLI puras no hPanel, esta variável é opcional, pois a execução CLI é autorizada nativamente.
CRON_SECRET_TOKEN="cne_angola_live_cron_2026"

# Endpoint base da API do Banco Mundial (permite mock ou espelho em testes)
WORLDBANK_API_BASE_URL="https://api.worldbank.org/v2/country/AGO/indicator"
